# Настройка сидирование ролей и их пермиссий.
RolesSeederOptions__RolesPath="Etc\Roles.json"
RolesSeederOptions__RolesPermissionsPath="Etc\RolesPermissions.json"

# Настройка seq и logger.
SeqOptions__ConnectionString="http://localhost:5341"
SeqOptions__AspNetCoreMinimumLevel="Microsoft.AspNetCore"
SeqOptions__LogEventLevel="Warning"

# Настройка postgres.
PostgresOptions__ConnectionString="Server=localhost;Port=5432;Database=kind_paws;User Id=postgres;Password=postgres;"