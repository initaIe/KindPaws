<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>KindPaws.Framework</PackageId>
        <Version>1.0.6</Version>
        <Authors>initaIe</Authors>
        <Description>Shared Framework for KindPaws project</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/initaIe/KindPaws</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KindPaws.SharedKernel" Version="1.0.1" />
        <PackageReference Include="KindPaws.Core" Version="1.0.0" />
    </ItemGroup>

</Project>
