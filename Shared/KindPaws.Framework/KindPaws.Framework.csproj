<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="KindPaws.Core" Version="1.0.7" />
    </ItemGroup>

    <PropertyGroup>
        <PackageId>KindPaws.Framework</PackageId>
        <Version>1.0.7</Version>
        <Authors>initaIe</Authors>
        <Description>Framework for KindPaws project</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/initaIe/KindPaws</RepositoryUrl>
    </PropertyGroup>
</Project>
